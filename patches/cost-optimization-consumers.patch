+def _prompt_caching_enabled() -> bool:
+    """True when the operator enabled OpenRouter prompt caching.
+
+    Resolved at call time so Settings UI changes take effect without a
+    process restart.
+    """
+    try:
+        return bool(get_stage_tunable('enable_prompt_caching'))
+    except Exception:
+        return False
+
+
+def _with_cache_control(system_message: dict[str, Any]) -> dict[str, Any]:
+    """Return a copy of ``system_message`` annotated for OpenRouter caching.
+
+    Only the system prompt is annotated: it is identical across every window
+    of an episode, while the per-window transcript content varies and would
+    rarely hit. The content-list form is the schema both OpenRouter and the
+    OpenAI SDK accept.
+    """
+    return {
+        'role': system_message['role'],
+        'content': [
+            {
+                'type': 'text',
+                'text': system_message['content'],
+                'cache_control': {'type': 'ephemeral'},
+            }
+        ],
+    }
+
