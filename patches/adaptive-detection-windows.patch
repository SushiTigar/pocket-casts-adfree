+# Threshold multiplier for the long-window check (pocket-casts-adfree).
+LARGE_WINDOW_BENEFIT_MULTIPLIER = 2.0
+PREFERRED_MAX_DETECTION_WINDOW_SECONDS = 900
+
+
+def _min_initial_detection_windows(episode_duration: float, base: float) -> int:
+    """How many pass-1 windows to aim for before the long-context widen path."""
+    windows = 2
+    if episode_duration > base * 4:
+        windows = 3
+    if episode_duration > base * 8:
+        windows = 4
+    by_chunk = int(
+        (episode_duration + PREFERRED_MAX_DETECTION_WINDOW_SECONDS - 1)
+        // PREFERRED_MAX_DETECTION_WINDOW_SECONDS
+    )
+    return max(windows, max(1, by_chunk))
+
+
+def resolve_window_size_seconds(model: str, episode_duration: float) -> float:
+    """Pick detection window size for a model and episode duration."""
+    base = float(get_stage_tunable('window_size_seconds'))
+    if not is_large_context_model(model):
+        return base
+    if episode_duration <= base * LARGE_WINDOW_BENEFIT_MULTIPLIER:
+        return base
+    large = max(float(get_stage_tunable('large_window_seconds')), base)
+    safe_cap = float(get_stage_tunable('detection_output_safe_window_seconds'))
+    if safe_cap > 0:
+        large = min(large, safe_cap)
+    min_windows = _min_initial_detection_windows(episode_duration, base)
+    per_window = max(base, episode_duration / min_windows)
+    large = min(large, per_window)
+    return max(base, large)
+
+
+SELF_PROMO_KEYWORDS = (
+    'premium', 'membership', 'subscribe', 'subscription', 'member', 'patron',
+    'patreon', 'merch', 'store', 'shop', 'cross-promo', 'crosspromo',
+    'cross promo', 'other show', 'sister show', 'network show',
+    'ad-free', 'ad free', 'adfree', 'support the show', 'support us',
+    'help the show', 'keep the show',
+)
+
+
+def _has_self_promo_language(text: str) -> bool:
+    if not text:
+        return False
+    lowered = text.lower()
+    return any(kw in lowered for kw in SELF_PROMO_KEYWORDS)
+
