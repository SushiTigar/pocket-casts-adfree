+    # Bool tunables are stored as "true"/"false" in the DB and accept the same
+    # truthy/falsy set on the way in. The kind lives in STAGE_TUNABLE_BOOL_KEYS
+    # so the API and resolver agree without duplicating the list. Garbage
+    # values (e.g. "perhaps") return None so the default is used -- the same
+    # fall-back-to-default contract as the other kinds.
+    if key in STAGE_TUNABLE_BOOL_KEYS:
+        if isinstance(raw, bool):
+            return raw
+        s = str(raw).strip().lower()
+        if s in _TRUTHY_STRINGS:
+            return True
+        if s in ('false', '0', 'no'):
+            return False
+        return None
