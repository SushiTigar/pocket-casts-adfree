+def _with_cache_control(system_message: Dict[str, Any]) -> Dict[str, Any]:
+    """Return a copy of ``system_message`` annotated for OpenRouter caching.
+
+    OpenRouter (and the upstream OpenAI Chat Completions API) honour the
+    ``cache_control: {"type": "ephemeral"}`` field on content blocks. We
+    only annotate the system prompt because (a) it's identical across
+    every window of a single episode -- the maximum possible hit rate --
+    and (b) the per-window transcript content varies so a cache key on
+    it would rarely hit in practice. Annotated as a content list (the
+    schema the OpenAI SDK accepts) so the same payload works for both
+    providers.
+    """
+    return {
+        'role': system_message['role'],
+        'content': [
+            {
+                'type': 'text',
+                'text': system_message['content'],
+                'cache_control': {'type': 'ephemeral'},
+            }
+        ],
+    }
+
