@@ -818,13 +885,54 @@ STAGE_TUNABLE_RANGES = {
     # envelope the resolver checks against.
     'window_size_seconds': (120, 1800),
     'window_overlap_seconds': (0, 1770),
+    # LLM cost optimisations. large_window_seconds must be >= window_size_seconds
+    # (cross-field, enforced at the API layer). skip_verification_under_seconds=0
+    # disables the skip; otherwise any value in [60, 86400] is accepted.
+    'large_window_seconds': (300, 3600),
+    'skip_verification_under_seconds': (0, 86400),
 }
 
 STAGE_TUNABLE_REASONING_LEVELS = {"none", "low", "medium", "high"}
 
+# Subset of STAGE_TUNABLE_DEFAULTS whose values are booleans. Listed
+# explicitly (rather than detected from the default value) so the API layer
+# can dispatch on it without re-deriving the type. Mirrors the 'bool' kind
+# tag in STAGE_TUNABLE_PAYLOAD_KEYS -- the two lists must stay in sync; the
+# test suite enforces that.
+STAGE_TUNABLE_BOOL_KEYS = frozenset((
+    'enable_prompt_caching',
+))
+
+# Model ID substring patterns that indicate a long-context model (>= 1M
+# tokens). Substring match is intentional: OpenRouter and similar gateways
+# namespace model IDs (e.g. ``deepseek/deepseek-v4-flash``,
+# ``google/gemini-2.5-flash``), so anchoring a regex to the full ID would
+# miss every gateway-routed request. The check is case-insensitive.
+LARGE_CONTEXT_MODEL_PATTERNS = (
+    'deepseek-v4',
+    'gemini-2.5-flash',
+    'gemini-3-flash',
+    'gemini-flash',
+    'qwen-long',
+    'llama-4-',
+    'llama-3.1-405b',  # 128k, included for safety on borderline cases
+)
+
+
+def is_large_context_model(model_id: str) -> bool:
+    """True if ``model_id`` looks like a long-context model.
+
+    Substring match against LARGE_CONTEXT_MODEL_PATTERNS, case-insensitive.
+    Returns False for empty / None so callers don't need to guard.
+    """
+    if not model_id:
+        return False
+    mid = model_id.lower()
+    return any(pat in mid for pat in LARGE_CONTEXT_MODEL_PATTERNS)
+
 
