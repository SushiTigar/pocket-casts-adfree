+
+def _parse_csv_env_list(raw: str) -> list[str]:
+    return [part.strip() for part in raw.split(',') if part.strip()]
+
+
+def _parse_bool_env(name: str, default: Optional[bool] = None) -> Optional[bool]:
+    raw = os.environ.get(name)
+    if raw is None:
+        return default
+    return str(raw).strip().lower() in ('true', '1', 'yes')
+
+
+def get_openrouter_provider_config() -> Optional[dict]:
+    """Build OpenRouter ``provider`` routing object from environment.
+
+    See https://openrouter.ai/docs/guides/routing/provider-selection
+
+    Env vars:
+        OPENROUTER_PROVIDER_ORDER: comma-separated provider slugs to try in order
+            (e.g. ``GMICloud,Novita,Alibaba`` — copy exact slugs from the model's
+            Providers tab on openrouter.ai).
+        OPENROUTER_ALLOW_FALLBACKS: ``true``/``false``. Defaults to ``false`` when
+            ``OPENROUTER_PROVIDER_ORDER`` is set, otherwise unset (OpenRouter default).
+        OPENROUTER_PROVIDER_SORT: ``price``, ``throughput``, or ``latency``.
+        OPENROUTER_PROVIDER_ONLY: comma-separated allow-list of provider slugs.
+        OPENROUTER_PROVIDER_IGNORE: comma-separated deny-list of provider slugs.
+    """
+    order_raw = os.environ.get('OPENROUTER_PROVIDER_ORDER', '').strip()
+    sort_raw = os.environ.get('OPENROUTER_PROVIDER_SORT', '').strip()
+    only_raw = os.environ.get('OPENROUTER_PROVIDER_ONLY', '').strip()
+    ignore_raw = os.environ.get('OPENROUTER_PROVIDER_IGNORE', '').strip()
+
+    provider: dict = {}
+    if order_raw:
+        provider['order'] = _parse_csv_env_list(order_raw)
+    if only_raw:
+        provider['only'] = _parse_csv_env_list(only_raw)
+    if ignore_raw:
+        provider['ignore'] = _parse_csv_env_list(ignore_raw)
+    if sort_raw:
+        provider['sort'] = sort_raw
+
+    allow_fb = _parse_bool_env('OPENROUTER_ALLOW_FALLBACKS')
+    if allow_fb is not None:
+        provider['allow_fallbacks'] = allow_fb
+    elif order_raw:
+        provider['allow_fallbacks'] = False
+
+    return provider or None
+
+MASTER_PASSPHRASE = os.environ.get('MINUSPOD_MASTER_PASSPHRASE')
+
+
+def provider_crypto_ready() -> bool:
+    return bool(MASTER_PASSPHRASE)
+
