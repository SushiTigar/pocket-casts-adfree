@@ -133,9 +140,31 @@ def detect_preroll(
         if show_start_time is not None:
             break
 
-    if show_start_time is None or show_start_time <= episode_start + 5.0:
+    if show_start_time is None:
         return None
 
+    if show_start_time <= episode_start + 5.0:
+        # The "show start" pattern is in the first 5s - it might be the ad itself
