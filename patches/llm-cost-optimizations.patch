+    return str(raw).strip().lower() in ('true', '1', 'yes')
+
+
+def get_openrouter_provider_config() -> dict | None:
+    """Build OpenRouter provider routing object from environment."""
+    order_raw = os.environ.get('OPENROUTER_PROVIDER_ORDER', '').strip()
+    sort_raw = os.environ.get('OPENROUTER_PROVIDER_SORT', '').strip()
+    only_raw = os.environ.get('OPENROUTER_PROVIDER_ONLY', '').strip()
+    ignore_raw = os.environ.get('OPENROUTER_PROVIDER_IGNORE', '').strip()
+
+    provider: dict = {}
+    if order_raw:
+        provider['order'] = _parse_csv_env_list(order_raw)
+    if only_raw:
+        provider['only'] = _parse_csv_env_list(only_raw)
+    if ignore_raw:
+        provider['ignore'] = _parse_csv_env_list(ignore_raw)
+    if sort_raw:
+        provider['sort'] = sort_raw
+
+    allow_fb = _parse_bool_env('OPENROUTER_ALLOW_FALLBACKS')
+    if allow_fb is not None:
+        provider['allow_fallbacks'] = allow_fb
+    elif order_raw:
+        provider['allow_fallbacks'] = False
+
+    return provider or None
