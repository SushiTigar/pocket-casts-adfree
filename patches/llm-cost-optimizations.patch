+def is_large_context_model(model_id: str) -> bool:
+    """True if ``model_id`` looks like a long-context model.
+
+    Substring match against LARGE_CONTEXT_MODEL_PATTERNS, case-insensitive.
+    Returns False for empty / None so callers don't need to guard.
+    """
+    if not model_id:
+        return False
+    mid = model_id.lower()
+    return any(pat in mid for pat in LARGE_CONTEXT_MODEL_PATTERNS)
