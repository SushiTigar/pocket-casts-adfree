+class TestLargeWindowCrossField:
+    """largeWindowSeconds must be >= windowSizeSeconds. The cross-field check
+    runs whenever any of the three window/overlap/large fields is in the
+    payload, and reads the *effective* value (incoming or stored) so an
+    inline-only change to large can still be validated against the existing
+    windowSizeSeconds."""
+
+    def test_large_below_base_rejected(self, client):
+        from database import Database
+        Database().set_setting('window_size_seconds', '600', is_default=False)
+        r = _put(client, {'largeWindowSeconds': 300})
+        assert r.status_code == 400
+        assert 'largeWindowSeconds' in json.loads(r.data)['error']
+
+    def test_large_equal_to_base_accepted(self, client):
+        from database import Database
+        Database().set_setting('window_size_seconds', '600', is_default=False)
+        r = _put(client, {'largeWindowSeconds': 600})
+        assert r.status_code == 200, r.data
+
+    def test_large_above_base_accepted(self, client):
+        from database import Database
+        Database().set_setting('window_size_seconds', '600', is_default=False)
+        r = _put(client, {'largeWindowSeconds': 1500})
+        assert r.status_code == 200
+
+    def test_inline_both_rejected(self, client):
