+
+class TestTunableRegistration:
+    """Sanity: defaults, payload keys, ranges, and bool keys are consistent.
+
+    A drift between these four structures (e.g. a key added to defaults but
+    not to payload_keys) would surface as a silent 422 at runtime. These
+    tests catch that at CI time.
+    """
+
+    def test_payload_keys_match_defaults(self):
+        for payload_key, db_key, _kind in config.STAGE_TUNABLE_PAYLOAD_KEYS:
+            assert db_key in config.STAGE_TUNABLE_DEFAULTS, (
+                f"STAGE_TUNABLE_PAYLOAD_KEYS has {db_key!r} but it's missing "
+                f"from STAGE_TUNABLE_DEFAULTS"
+            )
+
+    def test_new_tunables_in_defaults(self):
+        assert "large_window_seconds" in config.STAGE_TUNABLE_DEFAULTS
+        assert "skip_verification_under_seconds" in config.STAGE_TUNABLE_DEFAULTS
+        assert "enable_prompt_caching" in config.STAGE_TUNABLE_DEFAULTS
+
+    def test_new_tunables_in_payload_keys(self):
+        db_keys = {db for _pk, db, _k in config.STAGE_TUNABLE_PAYLOAD_KEYS}
+        assert "large_window_seconds" in db_keys
+        assert "skip_verification_under_seconds" in db_keys
+        assert "enable_prompt_caching" in db_keys
+
+    def test_new_tunables_in_ranges(self):
+        # enable_prompt_caching is a bool -- no numeric range.
+        assert "large_window_seconds" in config.STAGE_TUNABLE_RANGES
+        assert "skip_verification_under_seconds" in config.STAGE_TUNABLE_RANGES
+        assert config.STAGE_TUNABLE_RANGES["large_window_seconds"] == (300, 3600)
+        assert config.STAGE_TUNABLE_RANGES["skip_verification_under_seconds"] == (0, 86400)
+
+    def test_bool_keys_match_payload_kind(self):
+        # STAGE_TUNABLE_BOOL_KEYS and the 'bool' kind in payload keys
+        # must agree; otherwise a key would be coerced inconsistently.
+        bool_payload = {
+            db for _pk, db, kind in config.STAGE_TUNABLE_PAYLOAD_KEYS
+            if kind == "bool"
+        }
+        assert set(config.STAGE_TUNABLE_BOOL_KEYS) == bool_payload
