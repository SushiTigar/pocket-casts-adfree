 logger = logging.getLogger('podcast.claude')
 
 
+# Threshold multiplier for the "long enough to benefit from a bigger window"
+# check. We only widen windows for episodes that are at least
+# LARGE_WINDOW_BENEFIT_MULTIPLIER * base_size long -- a 12-min episode still
+# uses a 10-min base window because a single window covers the whole thing
+# either way. The bigger window only helps when the base window would create
+# enough chunks that cross-boundary ad context starts mattering.
+LARGE_WINDOW_BENEFIT_MULTIPLIER = 2.0
+
+
+def resolve_window_size_seconds(model: str, episode_duration: float) -> float:
+    """Pick the per-window size for a model/duration combination.
+
+    Long-context models (1M tokens) have plenty of headroom for the LLM to
+    consider surrounding context, so we can give them a bigger window
+    (``large_window_seconds``, default 20 min) and cut the per-episode call
+    count roughly in half. The override only fires for episodes longer than
+    ``LARGE_WINDOW_BENEFIT_MULTIPLIER * base_size`` -- short episodes don't
+    benefit and the base window already covers them.
+
+    Defensive clamp: returns ``max(large, base)`` so a misconfigured
+    ``large_window_seconds`` smaller than ``window_size_seconds`` doesn't
+    shrink the window below what the user explicitly asked for in the
+    Settings UI. The API cross-field check should prevent this, but the
+    env-var / direct-DB-write path can bypass that.
+    """
+    base = float(get_stage_tunable('window_size_seconds'))
+    if not is_large_context_model(model):
+        return base
+    if episode_duration <= base * LARGE_WINDOW_BENEFIT_MULTIPLIER:
+        return base
+    large = float(get_stage_tunable('large_window_seconds'))
+    return max(large, base)
+
