index 00000000..8913bca9
--- /dev/null
+++ b/tests/unit/test_llm_cost_optimizations.py
@@ -0,0 +1,312 @@
+"""Tests for LLM cost optimisations.
+
+Covers the four independent levers that reduce per-episode LLM cost on
+long-context cloud models like deepseek-v4-flash:
+
+  1. Long-context window override (resolve_window_size_seconds + is_large_context_model)
+  2. Skip verification pass for short episodes (skip_verification_under_seconds)
+  3. OpenRouter prompt caching (enable_prompt_caching + _with_cache_control)
+  4. Tunable registration: defaults, ranges, bool kind, cross-field validation
+"""
+import os
+from unittest.mock import patch
+
+import pytest
+
+import config
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+@pytest.fixture(autouse=True)
+def _flush_provider_cache():
+    """Clear the DB-backed TTL cache between tests so DB patches don't bleed.
+
+    Mirrors the fixture in test_stage_tunables.py.
+    """
+    try:
+        from llm_client import _clear_provider_cache
+        _clear_provider_cache()
+    except Exception:
+        pass
+    yield
+    try:
+        from llm_client import _clear_provider_cache
+        _clear_provider_cache()
+    except Exception:
+        pass
+
+
+def _clear_envs(monkeypatch, *keys):
+    for key in keys:
+        monkeypatch.delenv(key, raising=False)
+
+
+def _patch_db_fail():
+    """Patch Database so stage tunable resolver can't reach the DB.
+
+    Mirrors the pattern in test_stage_tunables.py: any DB read raises, the
+    resolver falls back to defaults (or env, when set).
+    """
+    return patch("database.Database", side_effect=Exception("no db in test"))
+
+
+# ---------------------------------------------------------------------------
+# 1. Long-context model detection
+# ---------------------------------------------------------------------------
+
+class TestLargeContextModelPatterns:
+    def test_deepseek_v4_matches(self):
+        # The user's actual model -- a substring match must hit.
+        assert config.is_large_context_model("deepseek/deepseek-v4-flash") is True
+
+    def test_gemini_flash_matches(self):
+        assert config.is_large_context_model("google/gemini-2.5-flash") is True
+        assert config.is_large_context_model("google/gemini-3-flash-preview") is True
+        assert config.is_large_context_model("gemini-flash-experimental") is True
+
+    def test_qwen_long_matches(self):
+        assert config.is_large_context_model("qwen-long-1m") is True
+
+    def test_short_context_models_rejected(self):
+        # These are not 1M-token models and must not match.
+        assert config.is_large_context_model("gpt-4o-mini") is False
+        assert config.is_large_context_model("claude-sonnet-4-5") is False
+        assert config.is_large_context_model("ollama/qwen3:14b") is False
+
+    def test_empty_or_none_returns_false(self):
+        # Defensive: callers should not have to guard against falsy inputs.
+        assert config.is_large_context_model("") is False
+        assert config.is_large_context_model(None) is False
+
+    def test_case_insensitive_match(self):
+        # OpenRouter / Ollama sometimes send mixed-case IDs.
+        assert config.is_large_context_model("DeepSeek/DeepSeek-V4-Flash") is True
+
+    def test_patterns_are_substrings(self):
+        # Sanity: the registered patterns should be substring patterns that
+        # cover the documented model families. A regression that replaces
+        # the list with regex would still pass the above tests, but a
+        # coverage check keeps the family list honest.
+        patterns = config.LARGE_CONTEXT_MODEL_PATTERNS
+        assert isinstance(patterns, tuple)
+        assert "deepseek-v4" in patterns
+        assert "gemini-2.5-flash" in patterns
+        assert "gemini-3-flash" in patterns
+        assert "gemini-flash" in patterns
+        assert "qwen-long" in patterns
+
+
+# ---------------------------------------------------------------------------
+# 2. resolve_window_size_seconds
+# ---------------------------------------------------------------------------
+
+class TestResolveWindowSize:
+    """The window resolver decides per-call size based on model + episode length.
+
+    Three branches:
+      - non-long-context model: always base window
+      - long-context model, short episode: base window
+      - long-context model, long episode: large window (>= base, clamped)
+    """
+
+    def test_short_context_model_returns_base(self, monkeypatch):
+        from ad_detector.prompts import resolve_window_size_seconds
+        _clear_envs(monkeypatch, "WINDOW_SIZE_SECONDS", "LARGE_WINDOW_SECONDS")
+        with _patch_db_fail():
+            # gpt-4o is not 1M-context; even a 5-hour episode should not bump it.
+            assert resolve_window_size_seconds("gpt-4o", 5 * 3600) == 600.0
+
+    def test_long_context_short_episode_returns_base(self, monkeypatch):
+        from ad_detector.prompts import resolve_window_size_seconds
+        # 12 min episode, 10 min base, 2x threshold = 20 min -- below
+        _clear_envs(monkeypatch, "WINDOW_SIZE_SECONDS", "LARGE_WINDOW_SECONDS")
+        with _patch_db_fail():
+            assert resolve_window_size_seconds(
+                "deepseek/deepseek-v4-flash", 12 * 60
+            ) == 600.0
+
+    def test_long_context_long_episode_uses_large_window(self, monkeypatch):
+        from ad_detector.prompts import resolve_window_size_seconds
+        # 60 min episode, base 10 min -- well above 2x threshold
+        _clear_envs(monkeypatch, "WINDOW_SIZE_SECONDS", "LARGE_WINDOW_SECONDS")
+        with _patch_db_fail():
+            assert resolve_window_size_seconds(
+                "deepseek/deepseek-v4-flash", 60 * 60
+            ) == 1200.0
+
+    def test_long_context_at_threshold_boundary(self, monkeypatch):
+        from ad_detector.prompts import resolve_window_size_seconds
+        # At exactly 2x base, the override kicks in. The strict > check
+        # means the boundary episode gets the larger window.
+        _clear_envs(monkeypatch, "WINDOW_SIZE_SECONDS", "LARGE_WINDOW_SECONDS")
+        with _patch_db_fail():
+            # 2 * 600 == 1200; 1200 > 1200 is False, so base is used
+            # (the threshold is "longer than 2x", not "at least 2x")
+            assert resolve_window_size_seconds(
+                "deepseek/deepseek-v4-flash", 1200.0
+            ) == 600.0
+            # 1200.1 sec (one tick over) gets the large window
+            assert resolve_window_size_seconds(
+                "deepseek/deepseek-v4-flash", 1200.1
+            ) == 1200.0
+
+    def test_large_window_below_base_is_clamped_up(self, monkeypatch):
+        from ad_detector.prompts import resolve_window_size_seconds
+        # Defensive: if the user misconfigures large < base, the resolver
+        # must still return at least base so windows don't shrink.
+        monkeypatch.setenv("LARGE_WINDOW_SECONDS", "300")  # below default base of 600
+        with _patch_db_fail():
+            # 60 min episode, deepseek-v4 -- would normally pick large,
+            # but clamp to base.
+            assert resolve_window_size_seconds(
+                "deepseek/deepseek-v4-flash", 60 * 60
+            ) == 600.0
+
+    def test_env_override_picks_up_in_resolver(self, monkeypatch):
+        from ad_detector.prompts import resolve_window_size_seconds
+        monkeypatch.setenv("LARGE_WINDOW_SECONDS", "1800")
+        with _patch_db_fail():
+            assert resolve_window_size_seconds(
+                "deepseek/deepseek-v4-flash", 60 * 60
+            ) == 1800.0
+
+
+# ---------------------------------------------------------------------------
+# 3. Skip verification pass threshold (defaults + coercion)
+# ---------------------------------------------------------------------------
+
+class TestSkipVerificationUnder:
+    def test_default(self, monkeypatch):
+        _clear_envs(monkeypatch, "SKIP_VERIFICATION_UNDER_SECONDS")
+        with _patch_db_fail():
+            assert config.get_stage_tunable("skip_verification_under_seconds") == 1200
+
+    def test_zero_disables_skip(self, monkeypatch):
+        # 0 means "always run pass 2" -- distinct from "use default".
+        monkeypatch.setenv("SKIP_VERIFICATION_UNDER_SECONDS", "0")
+        with _patch_db_fail():
+            assert config.get_stage_tunable("skip_verification_under_seconds") == 0
+
+    def test_out_of_range_falls_back_to_default(self, monkeypatch, caplog):
+        monkeypatch.setenv("SKIP_VERIFICATION_UNDER_SECONDS", "100000")
+        with _patch_db_fail():
+            assert config.get_stage_tunable("skip_verification_under_seconds") == 1200
+        assert any("out of range" in r.message for r in caplog.records)
+
+
+# ---------------------------------------------------------------------------
+# 4. Prompt caching toggle (bool kind + helpers)
+# ---------------------------------------------------------------------------
+
+class TestEnablePromptCaching:
+    def test_default_is_true(self, monkeypatch):
+        _clear_envs(monkeypatch, "ENABLE_PROMPT_CACHING")
+        with _patch_db_fail():
+            assert config.get_stage_tunable("enable_prompt_caching") is True
+
+    def test_env_can_disable(self, monkeypatch):
+        monkeypatch.setenv("ENABLE_PROMPT_CACHING", "false")
