+class DetectionBudgetExceeded(Exception):
+    """Episode hit the configured truncation budget; orchestrator must not reprocess."""
+
+
+def _detection_max_truncated_windows() -> int:
+    raw = os.environ.get('DETECTION_MAX_TRUNCATED_WINDOWS', '2').strip()
+    try:
+        return max(1, int(raw))
+    except ValueError:
+        return 2
+
+
+def _new_truncation_budget() -> Dict[str, Any]:
+    return {
+        'lock': threading.Lock(),
+        'count': 0,
+        'max': _detection_max_truncated_windows(),
+        'exceeded': False,
+    }
+
+
+def _bump_truncation_budget(budget: Optional[Dict[str, Any]]) -> bool:
+    """Record one truncated window. Returns True if the episode budget is exceeded."""
+    if not budget:
+        return False
+    with budget['lock']:
+        budget['count'] += 1
+        if budget['count'] > budget['max']:
+            budget['exceeded'] = True
+            return True
+    return budget['exceeded']
+
+
