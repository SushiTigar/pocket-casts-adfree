+class DetectionBudgetExceeded(Exception):
+    """Episode hit the configured truncation budget; orchestrator must not reprocess."""
+
+
+def _detection_max_truncated_windows() -> int:
+    raw = os.environ.get('DETECTION_MAX_TRUNCATED_WINDOWS', '6').strip()
+    try:
+        return max(1, int(raw))
+    except ValueError:
+        return 6
+
+
+def _min_detection_window_seconds() -> float:
+    return float(get_stage_tunable('window_size_seconds'))
+
+
+def _can_bisect_truncated_window(
+    window_start: float, window_end: float, num_segments: int,
+) -> bool:
+    """True when a truncated window can be split again (above base window size)."""
+    if num_segments <= 1:
+        return False
+    duration = window_end - window_start
+    return duration > _min_detection_window_seconds() * 1.05
+
+
+def _new_truncation_budget() -> Dict[str, Any]:
+    return {
+        'lock': threading.Lock(),
+        'count': 0,
+        'max': _detection_max_truncated_windows(),
+        'exceeded': False,
+    }
+
+
+def _bump_truncation_budget(budget: Optional[Dict[str, Any]]) -> bool:
+    """Record one truncated window. Returns True if the episode budget is exceeded."""
+    if not budget:
+        return False
+    with budget['lock']:
+        budget['count'] += 1
+        if budget['count'] > budget['max']:
+            budget['exceeded'] = True
+            return True
+    return budget['exceeded']
+
+
+def _truncation_budget_failed_response(last_error: Optional[Exception] = None) -> dict:
+    detail = (
+        "Ad detection hit the output token limit too many times in this episode "
+        "(even after automatic window splitting). Raise AD_DETECTION_MAX_TOKENS "
+        "or lower WINDOW_SIZE_SECONDS, restart MinusPod, then reprocess."
+    )
+    if last_error and str(last_error):
+        detail = f"{detail} ({last_error})"
+    return {
+        "ads": [],
+        "status": "failed",
+        "error": detail,
+        "retryable": False,
+        "last_error_type": type(last_error).__name__ if last_error else "DetectionBudgetExceeded",
+        "last_error_status": None,
+    }
+
