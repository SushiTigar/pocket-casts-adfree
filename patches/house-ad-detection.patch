+# Keywords and phrases that indicate a self-promotion / house ad.
+# Used by _has_self_promo_language to allow these through the
+# "no sponsor identified" gate (see parse_ads_from_response).
+SELF_PROMO_KEYWORDS = (
+    # Premium / membership / subscription language
+    'premium',
+    'membership',
+    'subscribe',
+    'subscription',
+    'member',
+    'patron',
+    'patreon',
+    # Merch / store
+    'merch',
+    'store',
+    'shop',
+    # Cross-promotion
+    'cross-promo',
+    'crosspromo',
+    'cross promo',
+    'other show',
+    'sister show',
+    'network show',
+    # Ad-free / support
+    'ad-free',
+    'ad free',
+    'adfree',
+    'support the show',
+    'support us',
+    'help the show',
+    'keep the show',
+)
+
+
+def _has_self_promo_language(text: str) -> bool:
+    """Return True if `text` contains self-promotion / house-ad language.
+
+    This is used as a positive evidence signal in the ad gate so that
+    long self-promo segments (e.g., "Giant Bomb Premium" membership reads)
+    are not rejected by the "no sponsor identified" filter.
+    """
+    if not text:
+        return False
+    lowered = text.lower()
+    return any(kw in lowered for kw in SELF_PROMO_KEYWORDS)
+
