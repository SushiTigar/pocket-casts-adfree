diff --git a/tests/unit/test_ad_boundary_padding.py b/tests/unit/test_ad_boundary_padding.py
new file mode 100644
index 00000000..14a0e0b5
--- /dev/null
+++ b/tests/unit/test_ad_boundary_padding.py
@@ -0,0 +1,94 @@
+"""AD_START_PAD / AD_END_PAD / AD_END_PAD_TAIL expand applied cut edges.
+
+compute_applied_cuts pads each surviving cut outward so the cut matches what
+remove_ads renders. The start pad is deliberately smaller than the end pad to
+avoid over-cutting show content at the head of an ad. These tests run with the
+suite's padding-neutralizing autouse fixture overridden, so they must set the
+env explicitly.
+"""
+
+import pytest
+
+from audio_processor import AudioProcessor
+
+
+@pytest.fixture
+def processor():
+    return AudioProcessor()
+
+
+@pytest.fixture(autouse=True)
+def _use_real_pad_defaults(monkeypatch):
+    # The suite-wide fixture pins the pads to 0; drop them so the code's own
+    # defaults apply here. Tests that want specific values set them explicitly.
+    for var in ('AD_START_PAD', 'AD_END_PAD', 'AD_END_PAD_TAIL'):
+        monkeypatch.delenv(var, raising=False)
+
+
+def test_default_start_pad_smaller_than_end(processor):
+    cuts = processor.compute_applied_cuts(
+        [{'start': 100.0, 'end': 130.0}], 600.0,
+    )
+    assert len(cuts) == 1
+    assert cuts[0]['start'] == pytest.approx(99.5)   # - AD_START_PAD (0.5)
+    assert cuts[0]['end'] == pytest.approx(131.0)    # + AD_END_PAD (1.0)
+
+
+def test_start_pad_clamped_to_zero(processor):
+    cuts = processor.compute_applied_cuts(
+        [{'start': 0.2, 'end': 30.0}], 600.0,
+    )
+    assert cuts[0]['start'] == 0.0
+    assert cuts[0]['end'] == pytest.approx(31.0)
+
+
+def test_negative_start_pad_insets_the_edge(processor, monkeypatch):
+    monkeypatch.setenv('AD_START_PAD', '-1.0')
+    cuts = processor.compute_applied_cuts(
+        [{'start': 100.0, 'end': 130.0}], 600.0,
+    )
+    # Inset: the cut starts later, removing less content at the head.
+    assert cuts[0]['start'] == pytest.approx(101.0)
+    assert cuts[0]['end'] == pytest.approx(131.0)
+
+
+def test_tail_ad_uses_tail_end_pad(processor, monkeypatch):
+    # A keep barrier blocks the end-of-episode extension, so the tail pad is
+    # observable: AD_END_PAD_TAIL applies (1.0), not AD_END_PAD (9.0).
+    monkeypatch.setenv('AD_END_PAD', '9.0')
+    monkeypatch.setenv('AD_END_PAD_TAIL', '1.0')
+    cuts = processor.compute_applied_cuts(
+        [{'start': 585.0, 'end': 596.0}], 600.0,
+        cut_barriers=[{'start': 597.5, 'end': 600.0}],
+    )
+    assert len(cuts) == 1
+    assert cuts[0]['end'] == pytest.approx(597.0)
+
+
+def test_non_tail_ad_uses_normal_end_pad(processor):
+    cuts = processor.compute_applied_cuts(
+        [{'start': 100.0, 'end': 130.0}], 600.0,
+    )
+    assert cuts[0]['end'] == pytest.approx(131.0)
+
+
+def test_env_overrides_applied(processor, monkeypatch):
+    monkeypatch.setenv('AD_START_PAD', '3.0')
+    monkeypatch.setenv('AD_END_PAD', '4.0')
+    monkeypatch.setenv('AD_END_PAD_TAIL', '4.0')
+    cuts = processor.compute_applied_cuts(
+        [{'start': 100.0, 'end': 130.0}], 600.0,
+    )
+    assert cuts[0]['start'] == pytest.approx(97.0)
+    assert cuts[0]['end'] == pytest.approx(134.0)
+
+
+def test_padding_cannot_rescue_short_untrusted_ad(processor):
+    # 9s untrusted ad: padding (0.5 + 2.0) would exceed the 10s floor, but the
+    # filter runs first so the hallucination is still dropped.
+    cuts = processor.compute_applied_cuts(
+        [{'start': 100.0, 'end': 109.0, 'confidence': 0.7,
+          'detection_stage': 'claude'}],
+        600.0,
+    )
+    assert cuts == []
diff --git a/tests/unit/test_ad_validator.py b/tests/unit/test_ad_validator.py
index 697586ed..b66214e0 100644
--- a/tests/unit/test_ad_validator.py
+++ b/tests/unit/test_ad_validator.py
@@ -172,6 +172,49 @@ class TestAdValidatorDifferentialHold:
         result = validator.validate([ad])
         assert result.ads[0].get('held_for_review') is not True
 
+    def test_sponsor_confirmed_differential_not_held(self):
+        # Regression: a mid-episode back-to-back ad block was detected ONLY by
+        # the cross-fetch differential stage, so it carried the uncorroborated
+        # hold even though the sponsor registry found a brand read (10x
+        # BetterHelp) inside the exact span. Sponsor confirmation is real
+        # corroboration, so the block must be accepted/cut, not held in audio.
+        description = '<strong>Sponsors:</strong><a href="https://betterhelp.com">BetterHelp</a>'
+        validator = AdValidator(
+            episode_duration=500.0,
+            segments=[],
+            episode_description=description,
+        )
+        ad = {
+            'start': 100.0,
+            'end': 290.0,
+            'confidence': 0.95,
+            'reason': 'BetterHelp sponsor read block',
+            'detection_stage': 'dai_differential',
+            'differential_uncorroborated': True,
+        }
+        result = validator.validate([ad])
+        out = result.ads[0]
+        assert out['validation']['decision'] == Decision.ACCEPT.value
+        assert out.get('held_for_review') is not True
+
+    def test_unconfirmed_differential_still_held_even_with_similar_confidence(self):
+        # The hold must survive for differential regions with NO sponsor read,
+        # so the false-positive class (editorial audio that merely differs
+        # across fetches) is never solo-cut -- even at 0.95 confidence.
+        validator = AdValidator(episode_duration=500.0, segments=[])
+        ad = {
+            'start': 100.0,
+            'end': 130.0,
+            'confidence': 0.95,
+            'reason': 'Audio differs across fetches; no other ad signal -- review',
+            'detection_stage': 'dai_differential',
+            'differential_uncorroborated': True,
+        }
+        result = validator.validate([ad])
+        out = result.ads[0]
+        assert out['validation']['decision'] == Decision.REVIEW.value
+        assert out.get('held_for_review') is True
+
 
 class TestAdValidatorMerging:
     """Tests for ad merging behavior."""
